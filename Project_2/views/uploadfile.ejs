<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>File Upload</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Tailwind CSS CDN -->
  </head>
  <body class="bg-zinc-800 flex justify-center items-center h-screen">
    <div class="container mx-auto mt-10">
      <h1 class="text-3xl font-bold text-white text-center mb-5">Upload Profile picture </h1>

      <div class="bg-white p-6 rounded-lg bg-zinc-700 shadow-md w-1/2 mx-auto">
        <form
          action="/upload"
          method="POST"
          enctype="multipart/form-data"
          class="space-y-4"
        >
          <div class="flex flex-col">
            <label for="file" class="text-lg  text-white font-semibold">Choose file</label>
            <input
              type="file"
              name="image"
              id="file"
              class="mt-2 p-2 border text-white text-lg border-gray-300 rounded"
            />
          </div>

          <button
            type="submit"
            class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded"
          >
            Upload
          </button>
        </form>
      </div>

    
    </div>
  </body>
</html>
